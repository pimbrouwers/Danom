[*.cs]
# This project intentionally stays on C# 9.0 syntax for compatibility/readability.
# Override broader repo-level modern-style suggestions here.

csharp_style_namespace_declarations = block_scoped:silent
csharp_style_implicit_object_creation_when_type_is_apparent = false:silent
csharp_prefer_simple_using_statement = false:silent
csharp_style_prefer_switch_expression = false:silent
csharp_style_prefer_tuple_swap = false:silent
csharp_style_prefer_index_operator = false:silent
csharp_style_prefer_range_operator = false:silent
csharp_style_prefer_simple_default_expression = false:silent
csharp_style_prefer_local_over_anonymous_function = false:silent
csharp_style_prefer_top_level_statements = false:silent
csharp_style_prefer_primary_constructors = false:silent
csharp_style_prefer_utf8_string_literals = false:silent
dotnet_style_prefer_collection_expression = false:silent

# In case higher-level config promotes these to diagnostics.
dotnet_diagnostic.IDE0090.severity = none
dotnet_diagnostic.IDE0161.severity = none
